# ===================================================================
# Telegram Auto Stars bot - muhit o'zgaruvchilari namunasi
# Lokal ishga tushirish uchun shu faylni .env deb nusxalang.
# Render'da .env KERAK EMAS: qiymatlarni Dashboard -> Environment ga kiriting.
# HECH QACHON .env faylini gitga push qilmang!
# ===================================================================

# --- Asosiy (majburiy) ---
# BotFather (@BotFather) dan olingan bot tokeni
BOT_TOKEN=123456789:AAE-XXXXXXXXX-MY-SECRET-TOKEN
# Admin foydalanuvchilar Telegram ID lari (vergul bilan ajrating)
ADMIN_IDS=123456789,987654321
# Bosh administrator ID (bo'sh qolsa ADMIN_IDS dagi birinchi ID olinadi)
SUPER_ADMIN_ID=123456789

# --- Majburiy obuna kanali ---
# @ belgisiz username: my_channel
REQUIRED_CHANNEL=
# Kanalning chat id raqami (bot kanalga admin qo'shilgan bo'lishi kerak)
REQUIRED_CHANNEL_ID=

# --- To'lovlar ---
PAYMENTS_PROVIDER_TOKEN=
# Karta orqali to'lov uchun ko'rsatiladigan karta raqami
PAYMENT_CARD=9860 0000 0000 0000
# Karta egasi (mini-app va botdagi to'lov oynasida ko'rinadi)
PAYMENT_CARD_HOLDER=ISM FAMILIYA

# --- TO'LIQ AVTO-TO'LOV (Humo/Uzcard Telegram bildirishnomalari) ---
# Mijoz summa tanlaydi -> bot noyob summa beradi (masalan 50 000 -> 50 037) ->
# mijoz aynan shu summani o'tkazadi -> userbot bank xabarini o'qib, summa bo'yicha
# buyurtmani topadi va balansni avtomatik to'ldiradi. Tranzaksiya ID shart emas.
#
#  1) Humo/Uzcard kartangizni bankning Telegram bildirishnoma botiga ulang
#     (masalan HUMOcardbot yoki bankingizning xabar boti).
#  2) ALOHIDA Telegram akkaunt oching (gift akkauntidan ham boshqa!) va
#     o'sha akkauntda bank botiga kirib, bildirishnomalarni yoqing.
#  3) Session yarating:  python tools/gen_session.py
#     Chiqqan uzun qatorni BANK_SESSION ga qo'ying. Bu qator akkauntga to'liq
#     kirish beradi - hech kimga bermang va gitga push qilmang!
BANK_SESSION=
# Bildirishnoma yuboradigan bot username'lari (vergul bilan): HUMOcardbot,CardXabarBot
BANK_SOURCE_CHATS=
# Zaxira: SMS-forwarder webhook orqali ham qabul qilish mumkin.
#       POST https://<servis>.onrender.com/api/bank/notify
#       Header:  X-Bank-Secret: <shu yerdagi qiymat>
#       Body:    {"text": "<SMS matni>"}
BANK_WEBHOOK_SECRET=
# Faqat admin /bankadd orqali qo'lda kiritsa ham avto-tekshiruvni yoqish: 1
BANK_AUTO=0
# Manba sozlanmasa: to'lovlar adminga qo'lda tasdiqlash uchun boradi.
TOPUP_MIN=5000
TOPUP_MAX=10000000
# Noyob summa shuncha sekund band turadi; shundan keyin to'lov bekor qilinadi
TOPUP_VERIFY_TIMEOUT=900

# --- SMM provayder (nakrutka API) ---
# Panelda ham kiritish mumkin, lekin Render bepul rejada baza restartda
# tozalanadi - shuning uchun env orqali berish ishonchliroq.
# URL: provayder API manzili (masalan https://smmprovider.com/api/v2)
SMM_API_URL=
SMM_API_KEY=
# Provayder valyutasi -> so'm kursi va ustama foiz
SMM_RATE=1
SMM_MARKUP=30

# --- PUBG UC nickname tekshiruvi (ixtiyoriy) ---
# URL ichida {id} bo'lishi mumkin. Bo'sh bo'lsa nickname tekshirilmaydi.
UC_LOOKUP_URL=
UC_LOOKUP_KEY=

# --- API (@Apilarimbot) ---
STARS_API_BASE_URL=
STARS_API_KEY=
# API qayta chaqiruv (webhook) uchun maxfiy kalit. Uzun, tasodifiy qiymat qo'ying!
API_CALLBACK_SECRET=change-me-strong-secret

# --- Ma'lumotlar bazasi ---
# Lokal: data/stars.db   |   Render (Persistent Disk): /var/data/stars.db
DB_PATH=data/stars.db

# --- WebApp (admin panel + mini-app) ---
WEBAPP_HOST=0.0.0.0
# Render PORT ni o'zi beradi (u WEBAPP_PORT dan ustun). Lokal uchun:
WEBAPP_PORT=8080
# Mini-app uchun OMMAVIY HTTPS URL. Render'da bo'sh qoldiring
# (RENDER_EXTERNAL_URL avtomatik ishlatiladi).
WEBAPP_BASE_URL=

# --- Qo'shimcha ---
TZ=Asia/Tashkent
# Faylga log yozish (Render'da kerak emas): 1 yoki 0
LOG_TO_FILE=0
# Render free tarifda servis uxlab qolmasligi uchun self-ping (default: yoqiq).
# Pullik tarifda 0 qiling.
KEEP_ALIVE=1
